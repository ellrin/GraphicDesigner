{
  "iterations": { "type": "int", "label": "迭代次數", "min": 2, "max": 12, "default": 8 },
  "fit": {
    "type": "select",
    "label": "貼合方式",
    "options": [
      { "value": "contain", "label": "維持黃金比例" },
      { "value": "stretch", "label": "拉伸填滿畫布" }
    ],
    "default": "contain"
  },
  "size": { "type": "number", "label": "大小（維持比例時）", "min": 0.2, "max": 1, "step": 0.01, "default": 1 },
  "position": {
    "type": "point",
    "label": "位置（左右、上下；0 靠左上，1 靠右下）",
    "default": { "x": 0, "y": 0 },
    "space": "canvas",
    "handle": false
  },
  "showSquares": { "type": "boolean", "label": "顯示分割正方形", "default": true },
  "showSpiral": { "type": "boolean", "label": "顯示螺旋線", "default": true }
}
