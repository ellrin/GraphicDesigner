{
  "align": {
    "type": "select",
    "label": "水平對齊",
    "options": [
      { "value": "left", "label": "靠左" },
      { "value": "center", "label": "置中" },
      { "value": "right", "label": "靠右" }
    ],
    "default": "left"
  },
  "verticalAlign": {
    "type": "select",
    "label": "垂直對齊",
    "options": [
      { "value": "top", "label": "靠上" },
      { "value": "middle", "label": "置中" },
      { "value": "bottom", "label": "靠下" }
    ],
    "default": "top"
  },
  "lineHeight": { "type": "number", "label": "行高", "min": 0.8, "max": 3, "step": 0.05, "default": 1.3 },
  "letterSpacing": { "type": "number", "label": "字距（em）", "min": -0.1, "max": 0.5, "step": 0.01, "default": 0 }
}
